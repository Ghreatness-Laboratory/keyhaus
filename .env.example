# Supabase public configuration (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App base URL used for auth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only key (never expose to client or commit to Git)
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform (restrict browser key by HTTP referrer + daily quota cap)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional server-only key for Geocoding API (falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY if unset)
GOOGLE_MAPS_SERVER_API_KEY=

# Anthropic Claude (server-only, used on-demand for 2D blueprint floor plans)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Hugging Face Inference (server-only, Depth-Anything-V2 for 2.5D parallax fallback)
DEPTH_ESTIMATION_API_URL=
DEPTH_ESTIMATION_API_KEY=

# Runtime feature flags for listing viewing modes (set "false" or "0" to disable without deploy)
FEATURE_AREA_VIEW=true
FEATURE_STREET_VIEW=true
FEATURE_2D_PLAN=true
FEATURE_3D_VIEW=true
